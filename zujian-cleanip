// ZID412 - Egern通用脚本小组件 -  IP综合报告
// 「综合报告」卡片（IPv4/IP归属/ASN/综合评分/纯净度/评分构成/风险检测/场景适配）
// 数据源: cleanip.io

export default async function (ctx) {
  var group = (ctx.env && ctx.env.GROUP) || 'DIRECT';
  var cacheKey = 'cleanip_card_' + group;
  var t0 = Date.now();

  // 读缓存
  var cached = null;
  try {
    cached = ctx.storage.getJSON(cacheKey);
    if (cached && cached.svg && (Date.now() - cached.ts) < 3600000) {
      cached.ageMin = Math.round((Date.now() - cached.ts) / 60000);
    } else {
      cached = null;
    }
  } catch (e) {
    cached = null;
  }

  // 缓存很新鲜(<2分钟): 直接秒开
  if (cached && (Date.now() - cached.ts) < 120000) {
    return cardWidget(cached.svg, '缓存 ' + cached.ageMin + 'min');
  }

  // 请求官方卡片（按当前出口 IP 渲染）
  var svg = null;
  try {
    var r = await ctx.http.get('https://cleanip.io/c/RHEK.svg', { policy: group, timeout: 8000 });
    var t = await r.text();
    if (t && t.indexOf('<svg') > -1) svg = t;
  } catch (e) {
    svg = null;
  }

  if (svg) {
    try { ctx.storage.setJSON(cacheKey, { svg: svg, ts: Date.now() }); } catch (e) {}
    return cardWidget(svg, (Date.now() - t0) + 'ms');
  }

  // 失败: 优先用缓存
  if (cached) return cardWidget(cached.svg, '缓存 ' + cached.ageMin + 'min');

  // 全失败: 错误提示
  return {
    type: 'widget',
    padding: 14,
    gap: 4,
    children: [
      { type: 'text', text: '卡片加载失败', font: { size: 'footnote', weight: 'semibold' }, textColor: '#A14E50', textAlign: 'center' },
      { type: 'text', text: 'cleanip.io 超时或被限流', font: { size: 'caption2' }, textColor: '#8A9199', textAlign: 'center' },
      { type: 'text', text: '可在脚本 env 填 GROUP=代理组名重试', font: { size: 'caption2' }, textColor: '#8A9199', textAlign: 'center' },
    ],
  };
}

/* 渲染卡片: 一张官方 SVG 图片占满组件 */
function cardWidget(svg, latency) {
  return {
    type: 'widget',
    padding: 6,
    children: [
      {
        type: 'image',
        src: 'data:image/svg+xml;base64,' + utf8ToBase64(svg),
        flex: 1,
        resizeMode: 'contain',
      },
    ],
  };
}

/* UTF-8 字符串 → Base64（兼容无 btoa 的 JS 环境） */
function utf8ToBase64(str) {
  var bytes = [];
  for (var i = 0; i < str.length; i++) {
    var c = str.charCodeAt(i);
    if (c < 0x80) {
      bytes.push(c);
    } else if (c < 0x800) {
      bytes.push(0xC0 | (c >> 6), 0x80 | (c & 0x3F));
    } else if (c < 0xD800 || c >= 0xE000) {
      bytes.push(0xE0 | (c >> 12), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));
    } else {
      i++;
      c = 0x10000 + (((c & 0x3FF) << 10) | (str.charCodeAt(i) & 0x3FF));
      bytes.push(0xF0 | (c >> 18), 0x80 | ((c >> 12) & 0x3F), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));
    }
  }
  var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
  var out = '', b = 0, n = 0;
  for (var j = 0; j < bytes.length; j++) {
    b = (b << 8) | bytes[j];
    n += 8;
    while (n >= 6) {
      n -= 6;
      out += chars[(b >> n) & 0x3F];
    }
  }
  if (n > 0) out += chars[(b << (6 - n)) & 0x3F];
  while (out.length % 4) out += '=';
  return out;
}
