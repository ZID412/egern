// ZID412 - Egern通用脚本小组件 -  IP综合报告
// 「综合报告」卡片（IPv4/IP归属/ASN/综合评分/纯净度/评分构成/风险检测/场景适配）
// 数据源: cleanip.io


var CARD_URL = 'https://cleanip.io/c/G72l.svg';

export default async function (ctx) {
  var group = (ctx.env && ctx.env.GROUP) || 'DIRECT';
  var cacheKey = 'cleanip_card_' + group;
  var t0 = Date.now();

  // 读缓存
  var cached = null;
  try {
    cached = ctx.storage.getJSON(cacheKey);
    if (cached && cached.svg && (Date.now() - cached.ts) < 3600000) {
      cached.ageMin = Math.round((Date.now() - cached.ts) / 60000);
    } else {
      cached = null;
    }
  } catch (e) {
    cached = null;
  }

  // 缓存很新鲜(<2分钟): 直接秒开
  if (cached && (Date.now() - cached.ts) < 120000) {
    return cardWidget(cached.svg, ctx.widgetFamily, '缓存 ' + cached.ageMin + 'min');
  }

  // 请求官方卡片
  var svg = null;
  try {
    var r = await ctx.http.get(CARD_URL, { policy: group, timeout: 8000 });
    var t = await r.text();
    if (t && t.indexOf('<svg') > -1) svg = t;
  } catch (e) {
    svg = null;
  }

  if (svg) {
    try { ctx.storage.setJSON(cacheKey, { svg: svg, ts: Date.now() }); } catch (e) {}
    return cardWidget(svg, ctx.widgetFamily, (Date.now() - t0) + 'ms');
  }

  // 失败: 优先用缓存
  if (cached) return cardWidget(cached.svg, ctx.widgetFamily, '缓存 ' + cached.ageMin + 'min');

  // 全失败: 错误提示
  return {
    type: 'widget',
    padding: 14,
    gap: 4,
    children: [
      { type: 'text', text: '卡片加载失败', font: { size: 'footnote', weight: 'semibold' }, textColor: '#A14E50', textAlign: 'center' },
      { type: 'text', text: 'cleanip.io 超时或被限流', font: { size: 'caption2' }, textColor: '#8A9199', textAlign: 'center' },
      { type: 'text', text: '可在脚本 env 填 GROUP=代理组名重试', font: { size: 'caption2' }, textColor: '#8A9199', textAlign: 'center' },
    ],
  };
}

/* 渲染卡片: 按 iOS 小组件标准画布等比适配，填满组件 */
function cardWidget(svg, family, latency) {
  var dims = svgDims(svg);
  // iOS 小组件标准画布尺寸(pt)
  var cw, ch;
  if (family === 'systemMedium') { cw = 329; ch = 155; }
  else if (family === 'systemSmall') { cw = 155; ch = 155; }
  else { cw = 329; ch = 345; } // systemLarge / ExtraLarge

  var scale = Math.min(cw / dims.w, ch / dims.h);
  var w = Math.max(40, Math.round(dims.w * scale));
  var h = Math.max(40, Math.round(dims.h * scale));

  return {
    type: 'widget',
    padding: 0,
    children: [
      {
        type: 'image',
        src: 'data:image/svg+xml;base64,' + utf8ToBase64(svg),
        width: w,
        height: h,
        resizeMode: 'contain',
      },
    ],
  };
}

/* 从 SVG 标签解析渲染尺寸 width/height（缺失时用 viewBox 后两位） */
function svgDims(svg) {
  var w = 480, h = 400;
  var m = svg.match(/<svg[^>]*\swidth="([0-9.]+)"[^>]*\sheight="([0-9.]+)"/);
  if (!m) m = svg.match(/<svg[^>]*\sheight="([0-9.]+)"[^>]*\swidth="([0-9.]+)"/);
  if (m) {
    w = parseFloat(m[1]); h = parseFloat(m[2]);
  } else {
    var v = svg.match(/viewBox="\s*([0-9.+-]+)\s+([0-9.+-]+)\s+([0-9.]+)\s+([0-9.]+)"/);
    if (v) { w = parseFloat(v[3]); h = parseFloat(v[4]); }
  }
  if (!w || !h || w <= 0 || h <= 0) { w = 480; h = 400; }
  return { w: w, h: h };
}

/* UTF-8 字符串 → Base64（兼容无 btoa 的 JS 环境） */
function utf8ToBase64(str) {
  var bytes = [];
  for (var i = 0; i < str.length; i++) {
    var c = str.charCodeAt(i);
    if (c < 0x80) {
      bytes.push(c);
    } else if (c < 0x800) {
      bytes.push(0xC0 | (c >> 6), 0x80 | (c & 0x3F));
    } else if (c < 0xD800 || c >= 0xE000) {
      bytes.push(0xE0 | (c >> 12), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));
    } else {
      i++;
      c = 0x10000 + (((c & 0x3FF) << 10) | (str.charCodeAt(i) & 0x3FF));
      bytes.push(0xF0 | (c >> 18), 0x80 | ((c >> 12) & 0x3F), 0x80 | ((c >> 6) & 0x3F), 0x80 | (c & 0x3F));
    }
  }
  var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';
  var out = '', b = 0, n = 0;
  for (var j = 0; j < bytes.length; j++) {
    b = (b << 8) | bytes[j];
    n += 8;
    while (n >= 6) {
      n -= 6;
      out += chars[(b >> n) & 0x3F];
    }
  }
  if (n > 0) out += chars[(b << (6 - n)) & 0x3F];
  while (out.length % 4) out += '=';
  return out;
}
